CLIMBDESK_DATASOURCE_URL=jdbc:postgresql://your-neon-host/your-database?sslmode=require
CLIMBDESK_DATASOURCE_USERNAME=your_neon_username
CLIMBDESK_DATASOURCE_PASSWORD=your_neon_password
CLIMBDESK_JWT_SECRET=replace_with_a_long_random_secret
CLIMBDESK_JWT_EXPIRES_IN=3600
CLIMBDESK_RABBITMQ_ENABLED=false
CLIMBDESK_RABBITMQ_PUBLISHER_ENABLED=false
CLIMBDESK_RABBITMQ_LISTENER_ENABLED=false
CLIMBDESK_RABBITMQ_HOST=localhost
CLIMBDESK_RABBITMQ_PORT=5672
CLIMBDESK_RABBITMQ_MANAGEMENT_PORT=15672
CLIMBDESK_RABBITMQ_USERNAME=climbdesk
CLIMBDESK_RABBITMQ_PASSWORD=climbdesk
CLIMBDESK_RABBITMQ_VIRTUAL_HOST=/
